SubDir HAIKU_TOP src add-ons kernel drivers network wlan rtl8814au ;

UsePrivateHeaders kernel net ;
UsePrivateKernelHeaders ;

KernelAddon rtl8814au :
	Driver.cpp
	Device.cpp
	RegisterIO.cpp
	Firmware.cpp
	EfuseReader.cpp
	PhyConfig.cpp
	TxPath.cpp
	RxPath.cpp
	WiFiManagement.cpp
	WPA2Crypto.cpp
	;

# Firmware binary for the RTL8814AU's Lexra 3081 MIPS MCU.
# Copied to /boot/system/data/firmware/rtl8814au/ at image build time.
HAIKU_WIFI_FIRMWARE_ARCHIVE on rtl8814au = rtl8814aufw.bin ;
HAIKU_WIFI_FIRMWARE_DO_EXTRACT on rtl8814au = false ;
