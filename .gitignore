# Build artifacts produced by package/build-hpkg.sh — staging dir
# (build/package_root/...) and the .hpkg output.
build/
*.hpkg

# Developer-local notes — see developer_notes.md.  Holds build-server
# paths, debug session traces, and the wpa2_join test helper; not the
# kind of thing that should ship in the distributable repo.
developer_notes.md

# build.ps1 has Kevin's specific paths baked in (build server,
# storage01 share) — keep it local; users with a Haiku source tree
# run package/build-hpkg.sh directly anyway.
package/build.ps1

# Local backup / editor noise.
*~
*.bak
.vscode/

# Output of scripts/air-noreboot.sh: per-attempt captures and syslog extracts.
# It writes into the current directory, which is the repo when run from here.
air-nr/

# Output of scripts/interleave-adapters.sh
adapter-results.txt

# Output of scripts/interleave-networks.sh
network-results.txt

# Output of scripts/interleave-scan-vs-noscan.sh
scan-results.txt

# Python bytecode. A .pyc embeds the absolute path of the source it was
# compiled from, so tracking one leaks the build machine's directory layout
# as well as being a build artifact.
__pycache__/
*.pyc
